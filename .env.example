# Environment variables for deployment to Vercel
# Copy this file to .env.local (for local dev) or set in Vercel dashboard for Production

# API (used by src/lib/api/billApi.ts)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001

# Optional PITC proxy for server-side bill fetching
# PITC_PROXY_URL=https://your-proxy.example.com/lesco

# Other optional vars
# NEXT_PUBLIC_SOME_OTHER_KEY=value
